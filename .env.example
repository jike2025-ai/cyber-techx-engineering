# Copy to .env for local use; on Vercel set these under Project > Settings > Environment Variables.
# Email delivery for the website forms (https://resend.com). Without it the forms show a friendly
# "not switched on yet" message and point visitors to WhatsApp/email instead.
RESEND_API_KEY=
# Sender. Use a verified domain address once you have a domain, e.g. "Cyber_Techx <hello@yourdomain.com>".
# Until then Resend's onboarding@resend.dev can only deliver to the email that owns the Resend account.
MAIL_FROM=Cyber_Techx Website <onboarding@resend.dev>
# Where enquiries are delivered (comma-separated). Defaults to the email in content/site.json.
MAIL_TO=cybertechxengineering@gmail.com
# Your public site address once you have a domain (used for canonical URLs and the sitemap).
SITE_URL=
